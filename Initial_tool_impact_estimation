C_GRID  = "#E8ECF0"
C_TEXT  = "#1A2332"
C_MUTED = "#6B7A8D"

def _style():
    plt.rcParams.update({
        "axes.spines.top":   False, "axes.spines.right": False,
        "axes.facecolor":    C_BG,  "figure.facecolor":  "white",
        "axes.grid":         True,  "grid.color":        C_GRID,
        "grid.linestyle":    ":",   "grid.alpha":        0.6,
        "font.family":       "sans-serif",
        "axes.labelcolor":   C_TEXT, "xtick.color": C_MUTED, "ytick.color": C_MUTED,})

def short(name):
    """Return a shortened display name for a model."""
    return (
        name.replace("/model/", "")
            .replace("-Instruct", "").replace("-instruct", "")
            .replace("-fp8-W8A16", "").replace("-FP8-dynamic", "")
            .replace("-2501", "")
            .replace("Qwen2.5-Coder", "Qwen-Coder")
            .replace("faster-whisper-large-v3-turbo-ct2", "Whisper-v3"))

def save(fig, name, fs=None, bucket=None):
    """Save figure locally and optionally upload to S3."""
    local = f"{name}.png"
    fig.savefig(local, dpi=150, bbox_inches="tight")
    print(f"  -> {local}")
    if fs and bucket:
        fs.put(local, f"{bucket}/{local}")
        print(f"     s3://{bucket}/{local}")
    plt.close(fig)

def plot_power_dec(df_dec, fs=None, bucket=None):
    """Plot 1: real-time power per PDU circuit from December snapshot.

    Each row in Energy_Data_Clean.csv has a unique timestamp (circuits are
    read sequentially, not simultaneously), so groupby(Datetime).sum() always
    returns single-circuit values.  The cluster total is computed as the sum
    of per-circuit means instead.
    """
    _style()
    gpu_col = next(
        (c for c in df_dec.columns
         if c in ("GPU", "NODE", "PDU")
         or (df_dec[c].dtype == object and c != "Datetime")),
        None)
    if not gpu_col:
        return

    pcol    = "Input Active Power Total (W)"
    gpus    = sorted(df_dec[gpu_col].unique())
    n_nodes = len(gpus)

    # Cluster total = sum of per-circuit means (timestamps are not aligned)
    cluster_mean_w = df_dec.groupby(gpu_col)[pcol].mean().sum()

    fig, ax = plt.subplots(figsize=(13, 4))
    for i, gpu in enumerate(gpus):
        sub = df_dec[df_dec[gpu_col] == gpu].sort_values("Datetime")
        ax.plot(sub["Datetime"], sub[pcol],
                linewidth=1.5, label=str(gpu), color=PALETTE[i % len(PALETTE)])

    # Draw cluster total as a horizontal reference line (not a time series,
    # since timestamps differ per circuit)
    ax.axhline(cluster_mean_w / n_nodes, color="black", linewidth=1.5,
               linestyle=":", alpha=0.5, label=f"Per-circuit avg ({cluster_mean_w/n_nodes:.0f} W)")

    ax.set_title(
        f"Dec 2025 -- PDU power per circuit (80-min snapshot) | "
        f"Cluster total: {cluster_mean_w:,.0f} W avg ({n_nodes} circuits)",
        fontsize=11, fontweight="bold",)
    ax.set_ylabel("Active power per circuit (W)")
    ax.xaxis.set_major_formatter(mdates.DateFormatter("%H:%M"))
    ax.legend(loc="upper left", fontsize=8, ncol=2)
    # Annotate cluster total in top-right corner
    label = (f"Cluster total\n"
             f"{cluster_mean_w:,.0f} W avg\n"
             f"({n_nodes} circuits x {cluster_mean_w/n_nodes:.0f} W)")
    ax.text(0.99, 0.96, label,
            transform=ax.transAxes, ha="right", va="top",
            fontsize=9, color="black",
            bbox=dict(boxstyle="round,pad=0.3", facecolor="white",
                      edgecolor="grey", alpha=0.8))
    plt.tight_layout()
    save(fig, "plot1_power_dec", fs, bucket)

def plot_power_feb(df_feb, fs=None, bucket=None):
    """Plot 2: Feb 2026 PDU active power -- hourly average timeline."""
    _style()
    pcol = "Input Active Power Total (W)"
    if pcol not in df_feb.columns:
        return
    hourly = (
        df_feb[["Datetime", pcol]].dropna()
        .sort_values("Datetime").set_index("Datetime")[pcol]
        .resample("1h").mean())
    fig, ax = plt.subplots(figsize=(14, 4))
    ax.fill_between(hourly.index, hourly.values, alpha=0.3, color=PALETTE[0])
    ax.plot(hourly.index, hourly.values, color=PALETTE[0], linewidth=1.3)
    ax.axhline(hourly.mean(), color=PALETTE[3], linewidth=1.5, linestyle="--",
               label=f"Mean: {hourly.mean():.0f} W")
    if len(hourly):
        for d in pd.date_range(
            hourly.index[0].normalize(),
            hourly.index[-1].normalize() + pd.Timedelta(days=1),
            freq="D"):
            if d.weekday() >= 5:
                ax.axvspan(d, d + pd.Timedelta(days=1),
                           color=C_GRID, alpha=0.5, zorder=0)
    ax.set_title("Feb 2026 -- PDU active power (hourly avg)",
                 fontsize=12, fontweight="bold")
    ax.set_ylabel("Active power (W)")
    ax.xaxis.set_major_formatter(mdates.DateFormatter("%d %b"))
    ax.xaxis.set_major_locator(mdates.WeekdayLocator(interval=1))
    plt.setp(ax.xaxis.get_majorticklabels(), rotation=30, ha="right")
    ax.legend(fontsize=10)
    plt.tight_layout()
    save(fig, "plot2_power_feb", fs, bucket)

