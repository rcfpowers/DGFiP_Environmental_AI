# 2. S3 helpers

# Resolved at runtime by list_data_files(); do not set manually.
_S3_WORKING_PREFIX = None

def get_fs():
    """Return an authenticated s3fs filesystem from Onyxia environment variables."""
    endpoint = os.environ.get("S3_ENDPOINT") or os.environ.get("AWS_S3_ENDPOINT")
    if not endpoint:
        raise EnvironmentError(
            "S3_ENDPOINT not set. Run this script inside an Onyxia service.")
    return s3fs.S3FileSystem(
        key=os.environ.get("AWS_ACCESS_KEY_ID"),
        secret=os.environ.get("AWS_SECRET_ACCESS_KEY"),
        token=os.environ.get("AWS_SESSION_TOKEN"),
        client_kwargs={
            "endpoint_url": endpoint,
            "region_name": os.environ.get("AWS_DEFAULT_REGION", "us-east-1"),},)

def s3_path(*parts):
    """Build a full S3 path under the working prefix resolved at runtime."""
    if _S3_WORKING_PREFIX:
        base = _S3_WORKING_PREFIX
    elif S3_SUBFOLDER.strip():
        base = f"{S3_BUCKET}/{S3_SUBFOLDER}"
    else:
        base = S3_BUCKET
    for p in parts:
        base = base.rstrip("/") + "/" + p.lstrip("/")
    return base

def list_data_files(fs):
    """
    List all data files, handling two deployment modes:
      - SSPCloud:     files are inside a subfolder (S3_SUBFOLDER != "")
      - Groupe Genes: files are at the bucket root  (S3_SUBFOLDER == "")
    Returns dict: {filename: full_s3_path}
    """
    global _S3_WORKING_PREFIX

    try:
        root_items = fs.ls(S3_BUCKET, detail=False)
    except Exception as e:
        print(f"  [ERR] Cannot list s3://{S3_BUCKET}: {e}")
        return {}

    bucket_prefix = S3_BUCKET.rstrip("/") + "/"
    root_entries  = [
        p[len(bucket_prefix):] if p.startswith(bucket_prefix) else p.split("/")[-1]
        for p in root_items]
    print(f"  Bucket root entries: {root_entries}")

    # ── Case A: no subfolder (Groupe Genes, files at bucket root)
    if not S3_SUBFOLDER.strip():
        csv_files = [e for e in root_entries if e.endswith(".csv")]
        print(f"  No subfolder configured -- using bucket root ({len(csv_files)} CSVs found)")
        _S3_WORKING_PREFIX = S3_BUCKET.rstrip("/")
        result = {e: f"{S3_BUCKET}/{e}" for e in root_entries if e}
        for fname in sorted(f for f in result if f.endswith(".csv")):
            print(f"    - {repr(fname)}")
        return result

    # ── Case B: files inside a subfolder (SSPCloud) 
    # Match subfolder by stripped name (tolerates trailing space in MinIO)
    subfolder_match = next(
        (e for e in root_entries if e.strip().lower() == S3_SUBFOLDER.strip().lower()),
        next((e for e in root_entries if e.strip().lower().startswith("policy")), None),)
    if subfolder_match is None:
        print(f"  [ERR] Subfolder matching '{S3_SUBFOLDER}' not found in bucket root.")
        return {}

    folder_path = f"{S3_BUCKET}/{subfolder_match}"
    print(f"  Entering folder: s3://{folder_path}")

    try:
        items = fs.ls(folder_path, detail=False)
    except Exception as e:
        print(f"  [ERR] Cannot list s3://{folder_path}: {e}")
        return {}

    folder_prefix = folder_path.rstrip("/") + "/"
    result = {p[len(folder_prefix):].strip(): p
        for p in items
        if p[len(folder_prefix):].strip()}

    _S3_WORKING_PREFIX = folder_path.rstrip("/")
    print(f"  Found {len(result)} files in s3://{folder_path}:")
    for fname in sorted(result):
        print(f"    - {repr(fname)}")
    return result

def _check_credentials():
    """Print S3 credential status and raise clearly if missing or expired."""
    key    = os.environ.get("AWS_ACCESS_KEY_ID",     "")
    secret = os.environ.get("AWS_SECRET_ACCESS_KEY", "")
    token  = os.environ.get("AWS_SESSION_TOKEN",     "")
    ep     = os.environ.get("S3_ENDPOINT") or os.environ.get("AWS_S3_ENDPOINT", "")

    print("  Credential check:")
    print(f"    S3_ENDPOINT          : {ep or '[MISSING]'}")
    print(f"    AWS_ACCESS_KEY_ID    : {key[:8] + '...' if key else '[MISSING]'}")
    print(f"    AWS_SECRET_ACCESS_KEY: {'set' if secret else '[MISSING]'}")
    print(f"    AWS_SESSION_TOKEN    : "
          f"{'set (' + str(len(token)) + ' chars)' if token else '[MISSING]'}")

    missing = [v for v, x in [("S3_ENDPOINT", ep),
                               ("AWS_ACCESS_KEY_ID", key),
                               ("AWS_SECRET_ACCESS_KEY", secret)] if not x]
    if missing:
        raise EnvironmentError(
            f"Missing environment variables: {missing}\n"
            "Restart the Onyxia service or run: source /vault/secrets/s3")

    try:
        fs_test = s3fs.S3FileSystem(
            key=key, secret=secret, token=token or None,
            client_kwargs={"endpoint_url": ep,
                           "region_name": os.environ.get("AWS_DEFAULT_REGION", "us-east-1")},)
        fs_test.ls(S3_BUCKET)
        print("  S3 connectivity     : OK")
    except Exception as e:
        err = str(e)
        if "InvalidAccessKeyId" in err or "does not exist" in err:
            raise EnvironmentError(
                f"S3 credentials INVALID or EXPIRED.\n"
                f"Fix: restart the Onyxia Jupyter service.\nOriginal error: {e}")
        elif "NoSuchBucket" in err:
            raise EnvironmentError(
                f"Bucket '{S3_BUCKET}' not found. Check S3_BUCKET in config.\n"
                f"Original error: {e}")
        else:
            print(f"  [WARN] S3 connectivity test failed: {e} -- continuing anyway.")

# 3. Data loading from zip / S3

def download_and_extract_zip(fs, local_dir="./diane_data"):
    """
    Download ZIP_FILENAME from S3, extract all CSV files to local_dir,
    optionally re-upload CSVs to the bucket root, and return
    {filename: local_path} for all extracted CSVs.
    """
    os.makedirs(local_dir, exist_ok=True)
    zip_s3_path = s3_path(ZIP_FILENAME)
    print(f"  Downloading: s3://{zip_s3_path}")

    try:
        with fs.open(zip_s3_path, "rb") as fh:
            zip_bytes = fh.read()
        print(f"  Downloaded: {len(zip_bytes)/1e6:.1f} MB")
    except Exception as e:
        print(f"  [ERR] Cannot download zip: {e}  (path={zip_s3_path})")
        return {}

    extracted = {}
    try:
        with zipfile.ZipFile(io.BytesIO(zip_bytes)) as zf:
            members = zf.namelist()
            print(f"  Zip contains {len(members)} files:")
            for m in members:
                print(f"    - {m}")
            for member in members:
                if not member.endswith(".csv"):
                    continue
                fname = os.path.basename(member)
                if not fname:
                    continue
                local_path = os.path.join(local_dir, fname)
                with zf.open(member) as src_f, open(local_path, "wb") as dst_f:
                    dst_f.write(src_f.read())
                extracted[fname] = local_path
                print(f"  Extracted: {fname} -> {local_path}")
    except zipfile.BadZipFile as e:
        print(f"  [ERR] Bad zip: {e}")
        return {}

    if UPLOAD_AFTER_EXTRACT and extracted:
        dest_bucket = S3_BUCKET
        print(f"\n  Uploading {len(extracted)} CSVs to s3://{dest_bucket}/...")
        for fname, local_path in extracted.items():
            try:
                fs.put(local_path, f"{dest_bucket}/{fname}")
                print(f"    Uploaded: {fname}")
            except Exception as e:
                print(f"    [WARN] Could not upload {fname}: {e}")

    return extracted

def _check_token_granularity(usage):
    """
    Detect whether the LiteLLM export contains per-model token counts or
    per-team totals replicated across all models (a known export format issue).
    Prints a warning if replication is detected -- does not raise an error
    because energy/CO2 totals remain valid regardless.
    """
    suspicious_days = 0
    total_days = 0
    for date, group in usage.groupby("Date"):
        if len(group) < 2:
            continue
        total_days += 1
        # If all models on the same day have the exact same token count,
        # the file is almost certainly a team-level export replicated per model.
        tok_vals = group["Total Tokens"].unique()
        if len(tok_vals) == 1:
            suspicious_days += 1

    if total_days == 0:
        return

    ratio = suspicious_days / total_days
    if ratio > 0.5:
        print(
            f"\n  [WARN] Token granularity: on {suspicious_days}/{total_days} days "
            f"all models share identical token counts.")
        print(
            "         This LiteLLM export is per-TEAM, not per-MODEL.")
        print(
            "         Energy/CO2 totals are unaffected (from PDU).")
        print(
            "         Per-model attribution relies on params/architecture only.")
        print(
            "         kWh/Mtok values are not meaningful with this export format.")
    else:
        print(f"  [OK]  Token granularity: per-model data confirmed "
              f"({total_days - suspicious_days}/{total_days} days have distinct values).")

def load_csv_local(local_paths):
    """
    Load usage CSVs from a dict {filename: local_path}.
    Skips PDU/energy/output files; keeps only LiteLLM usage exports.
    Returns a combined DataFrame or None if nothing loaded.
    """
    USAGE_KW   = ("usage", "diane", "model", "litellm", "fevrier", "february")
    EXCLUDE_KW = ("energy_data", "releves_ai", "voie", "pdu", "releve_diane",
                  "energy_per_model", "energy_summary", "energy_uptime",
                  "unified_dataset")
    dfs = []
    for fname, path in local_paths.items():
        fl = fname.lower()
        if any(kw in fl for kw in EXCLUDE_KW):
            print(f"  [SKIP] {fname}")
            continue
        if not any(kw in fl for kw in USAGE_KW):
            continue
        try:
            df = pd.read_csv(path)
            print(f"  Loaded local: {fname} ({len(df):,} rows)")
            dfs.append(df)
        except Exception as e:
            print(f"  [ERR] {fname}: {e}")

    if not dfs:
        return None

    usage = pd.concat(dfs, ignore_index=True)
    usage.columns     = usage.columns.str.strip()
    usage["Date"]         = pd.to_datetime(usage["Date"])
    usage["Total Tokens"] = pd.to_numeric(usage["Total Tokens"], errors="coerce").fillna(0)
    usage["Requests"]     = pd.to_numeric(usage["Requests"],     errors="coerce").fillna(0)
    usage["Spend ($)"]    = pd.to_numeric(usage["Spend ($)"],    errors="coerce").fillna(0)
    usage = usage.drop_duplicates(subset=["Date", "Model"]).reset_index(drop=True)
    _check_token_granularity(usage)
    return usage

def _auto_dt(df, source_name):
    """Detect and rename the datetime column; parse to UTC-aware datetime."""
    for c in df.columns:
        if any(kw in c.lower() for kw in ("datetime","date","time","timestamp","horodatage")):
            if c != "Datetime":
                print(f"    [INFO] '{c}' -> 'Datetime'")
                df = df.rename(columns={c: "Datetime"})
            df["Datetime"] = pd.to_datetime(df["Datetime"], utc=True, errors="coerce")
            return df
    raise ValueError(f"No datetime column in {source_name}. Columns: {list(df.columns)}")

def load_energy_dec(fs, bucket, filename, local=False):
    """
    Load Energy_Data_Clean.csv (Dec 2025 PDU snapshot).
    Accepts either a local path (local=True) or an S3 path.
    Returns a DataFrame with columns: Datetime, GPU, Input Active Power Total (W).
    """
    if local:
        print(f"  Reading local: {filename}")
        with open(filename, "rb") as fh:
            df = pd.read_csv(fh)
    else:
        full_path = filename if not bucket else f"{bucket}/{filename}"
        print(f"  Reading: s3://{full_path}")
        with fs.open(full_path) as fh:
            df = pd.read_csv(fh)

    df.columns = df.columns.str.strip()
    df = _auto_dt(df, filename)

    # Rename the first column matching gpu/node/pdu keywords to 'GPU'
    gpu_cands = [
        c for c in df.columns
        if any(kw in c.lower() for kw in ("gpu","node","pdu","voie","circuit","rack"))
        and c != "Datetime"]
    if gpu_cands and gpu_cands[0] != "GPU":
        df = df.rename(columns={gpu_cands[0]: "GPU"})

    for col in ["Input Active Power Total (W)", "Input Cumulated Energy Total (Wh)"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    n_gpu = df["GPU"].nunique() if "GPU" in df.columns else "?"
    print(f"    Rows: {len(df):,} | GPU nodes: {n_gpu}")
    return df

def load_energy_feb(fs, bucket, filename, local=False):
    """
    Load releves_AI_FEB_2026.csv (Feb 2026 cumulative PDU counter).
    Derives ID_Voie from the source_file column, then computes per-circuit
    energy as the sum of consecutive positive differences (discarding resets).
    Returns (df_raw, total_energy_wh, energy_per_voie_df).
    """
    if local:
        print(f"  Reading local: {filename}")
        with open(filename, "rb") as fh:
            df = pd.read_csv(fh)
    else:
        full_path = filename if not bucket else f"{bucket}/{filename}"
        print(f"  Reading: s3://{full_path}")
        with fs.open(full_path) as fh:
            df = pd.read_csv(fh)

    df.columns = df.columns.str.strip()
    df = _auto_dt(df, filename)

    if "source_file" in df.columns:
        df["ID_Voie"] = (
            df["source_file"]
            .str.replace(".csv", "", regex=False)
            .str.rsplit("_", n=1).str[0])
    elif "ID_Voie" not in df.columns:
        df["ID_Voie"] = "single_circuit"
        print("    [WARN] No source_file column -- treating as single circuit")

    energy_col = "Input Cumulated Energy Total (Wh)"
    power_col  = "Input Active Power Total (W)"
    for col in [energy_col, power_col]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    if energy_col not in df.columns:
        print("    [WARN] No cumulative energy column -- cannot compute diff")
        return df, None, None

    df = df.sort_values(["ID_Voie", "Datetime"]).reset_index(drop=True)
    df["energy_diff_wh"] = df.groupby("ID_Voie")[energy_col].diff()

    n_resets = (df["energy_diff_wh"] < 0).sum()
    if n_resets:
        print(f"    [INFO] {n_resets} reset events filtered")
    df_valid = df[df["energy_diff_wh"] >= 0].copy()

    energy_per_voie = (
        df_valid.groupby("ID_Voie")["energy_diff_wh"]
        .sum().reset_index()
        .rename(columns={"energy_diff_wh": "total_wh"}))
    total_wh = energy_per_voie["total_wh"].sum()

    print(f"    Circuits (ID_Voie) : {df['ID_Voie'].nunique()}")
    print(f"    Rows               : {len(df):,} ({len(df_valid):,} valid)")
    print(f"    Total energy (diff): {total_wh/1000:,.1f} kWh")
    if power_col in df.columns:
        print(f"    Avg active power   : {df[power_col].dropna().mean():,.0f} W")

    return df, total_wh, energy_per_voie

def _parse_pdu_filename(fname):
    """
    Extract circuit metadata from a PDU filename.
    E.g. '101_J37_Voie1_20260210.csv' -> {rack: J37, voie: Voie1, ...}
    """
    base  = os.path.splitext(os.path.basename(fname))[0]
    parts = base.split("_")
    rack    = parts[1] if len(parts) > 1 else "unknown"
    voie    = parts[2] if len(parts) > 2 else "unknown"
    datestr = parts[3] if len(parts) > 3 else ""
    return {
        "rack":        rack,
        "voie":        voie,
        "circuit_id":  f"{rack}_{voie}",
        "source_file": base,
        "file_date":   datestr,}

def _load_pdu_files_local(local_files):
    """Load PDU circuit CSVs from a dict of local paths extracted from zip."""
    PAT = re.compile(r"[0-9]+_[A-Z][0-9]+_Voie[0-9]+_[0-9]+\.csv$", re.IGNORECASE)
    dfs = []
    for fname, path in sorted(local_files.items()):
        if not PAT.search(fname):
            continue
        try:
            df = pd.read_csv(path)
            df.columns = df.columns.str.strip()
            for k, v in _parse_pdu_filename(fname).items():
                df[k] = v
            dfs.append(df)
            print(f"    {fname}: {len(df):,} rows")
        except Exception as e:
            print(f"    [ERR] {fname}: {e}")
    if not dfs:
        return pd.DataFrame()
    combined = pd.concat(dfs, ignore_index=True)
    n_circ = combined["circuit_id"].nunique()
    print(f"  PDU combined: {len(combined):,} rows | {n_circ} circuits")
    return combined

def _load_pdu_files_s3(fs, available):
    """Load PDU circuit CSVs directly from S3 available-files dict."""
    PAT = re.compile(r"[0-9]+_[A-Z][0-9]+_Voie[0-9]+_[0-9]+\.csv$", re.IGNORECASE)
    dfs = []
    for fname, fpath in sorted(available.items()):
        if not PAT.search(fname):
            continue
        try:
            with fs.open(fpath) as fh:
                df = pd.read_csv(fh)
            df.columns = df.columns.str.strip()
            for k, v in _parse_pdu_filename(fname).items():
                df[k] = v
            dfs.append(df)
            print(f"    {fname}: {len(df):,} rows")
        except Exception as e:
            print(f"    [ERR] {fname}: {e}")
    if not dfs:
        return pd.DataFrame()
    combined = pd.concat(dfs, ignore_index=True)
    print(f"  PDU combined: {len(combined):,} rows | {combined['circuit_id'].nunique()} circuits")
    return combined

def build_unified_dataset(fs, bucket, usage, df_pdu, output_key="diane_unified_dataset.csv"):
    """
    Build a daily unified dataset: usage stats + PDU energy per day.
    Saves to S3 and returns the DataFrame.
    Columns: Date, total_requests, total_tokens, total_spend, n_models,
             pdu_it_kwh_total, pdu_n_circuits, pdu_avg_power_w,
             facility_kwh, co2_kg_day, wh_per_req, kwh_per_mtok
    """
    print("  Building unified dataset...")

    usage_daily = (
        usage.groupby("Date")
        .agg(
            total_requests=("Requests",     "sum"),
            total_tokens  =("Total Tokens", "sum"),
            total_spend   =("Spend ($)",    "sum"),
            n_models      =("Model",        "nunique"),)
        .reset_index())

    if df_pdu.empty:
        print("  [WARN] No PDU circuit data -- energy columns will be NaN")
        unified = usage_daily
    else:
        dt_col  = next(
            (c for c in df_pdu.columns
             if any(kw in c.lower() for kw in ("datetime","date","time","horodatage"))),
            None)
        eng_col = next(
            (c for c in df_pdu.columns if "cumul" in c.lower() and "wh" in c.lower()),
            None)
        pwr_col = next(
            (c for c in df_pdu.columns if "active" in c.lower() and "power" in c.lower()),
            None)

        if dt_col:
            df_pdu[dt_col] = pd.to_datetime(df_pdu[dt_col], utc=True, errors="coerce")
            df_pdu["Date"] = df_pdu[dt_col].dt.normalize().dt.tz_localize(None)

        unified = usage_daily.copy()

        if eng_col:
            df_pdu[eng_col] = pd.to_numeric(df_pdu[eng_col], errors="coerce")
            cir_day = (
                df_pdu.groupby(["circuit_id", "Date"])[eng_col]
                .agg(["min", "max"]).reset_index())
            cir_day["kwh_day"] = ((cir_day["max"] - cir_day["min"]) / 1000).clip(lower=0)
            energy_agg = (
                cir_day.groupby("Date")
                .agg(pdu_it_kwh_total=("kwh_day", "sum"),
                     pdu_n_circuits  =("circuit_id", "nunique"))
                .reset_index())
            unified = unified.merge(energy_agg, on="Date", how="left")

        if pwr_col:
            df_pdu[pwr_col] = pd.to_numeric(df_pdu[pwr_col], errors="coerce")
            power_agg = (
                df_pdu.groupby("Date")[pwr_col]
                .mean().reset_index()
                .rename(columns={pwr_col: "pdu_avg_power_w"}))
            unified = unified.merge(power_agg, on="Date", how="left")

    if "pdu_it_kwh_total" in unified.columns:
        unified["facility_kwh"] = unified["pdu_it_kwh_total"] * PUE
        unified["co2_kg_day"]   = unified["facility_kwh"] * CO2_FACTOR
        unified["wh_per_req"]   = unified["facility_kwh"] * 1000 / unified["total_requests"]
        unified["kwh_per_mtok"] = unified["facility_kwh"] / (unified["total_tokens"] / 1e6)

    unified = unified.sort_values("Date").reset_index(drop=True)

    try:
        with fs.open(f"{bucket}/{output_key}", "w") as fh:
            unified.to_csv(fh, index=False)
        print(f"  -> Unified dataset saved: s3://{bucket}/{output_key}")
        print(f"     {len(unified):,} rows | {len(unified.columns)} columns")
        print(f"     Columns: {list(unified.columns)}")
    except Exception as e:
        unified.to_csv("diane_unified_dataset.csv", index=False)
        print(f"  [WARN] S3 save failed ({e}) -- saved locally: diane_unified_dataset.csv")

    return unified

# 4. HuggingFace model parameter lookup

def _hf_detect_dtype(config, model_name):
    n = model_name.lower()
    if "fp8" in n or "int8" in n: return "fp8"
    if "int4" in n:               return "int4"
    if "mxfp4" in n:              return "mxfp4_moe_90pct"
    dtype = (config.get("torch_dtype") or "").lower()
    if "float16"  in dtype: return "fp16"
    if "bfloat16" in dtype: return "bf16"
    if "float32"  in dtype: return "fp32"
    return "bf16"

def _hf_detect_moe(config):
    n_exp = (config.get("num_experts") or config.get("num_local_experts")
             or config.get("ffn_num_experts") or config.get("n_routed_experts"))
    top_k = (config.get("num_experts_per_tok") or config.get("top_k_experts")
             or config.get("num_selected_experts") or config.get("n_experts_per_token"))
    is_moe = bool(n_exp) or any(
        "moe" in a.lower() or "mixtral" in a.lower()
        for a in config.get("architectures", []))
    return is_moe, (int(n_exp) if n_exp else None), (int(top_k) if top_k else None)

def fetch_hf_info(model_name, hf_repo, token=None):
    """Fetch parameter count, dtype, and MoE config from HuggingFace Hub."""
    result = {
        "params_B": None,
        "dtype":    MODEL_DTYPE.get(model_name, "bf16"),
        "moe": False, "n_experts": None, "top_k": None,}
    if not HF_AVAILABLE or hf_repo is None:
        return result
    try:
        api  = HfApi(token=token)
        info = api.model_info(hf_repo)
        if info.safetensors and info.safetensors.total:
            result["params_B"] = round(info.safetensors.total / 1e9, 3)
            print(f"  [HF]   {model_name}: {result['params_B']:.3f}B (safetensors)")
        try:
            path = hf_hub_download(hf_repo, "config.json", token=token)
            with open(path) as f:
                config = json.load(f)
        except Exception:
            config = {}
        if result["params_B"] is None:
            for key in ("num_parameters", "n_params"):
                if key in config:
                    result["params_B"] = round(config[key] / 1e9, 3)
                    print(f"  [HF]   {model_name}: {result['params_B']:.3f}B "
                          f"(config.{key})")
                    break
        if result["params_B"] is None:
            print(f"  [--]   {model_name}: no param data on HF")
        if model_name not in MODEL_DTYPE:
            result["dtype"] = _hf_detect_dtype(config, model_name)
        is_moe, n_exp, top_k = _hf_detect_moe(config)
        if is_moe:
            result.update({"moe": True, "n_experts": n_exp, "top_k": top_k})
            print(f"  [MoE]  {model_name}: {n_exp} experts top-{top_k} (auto)")
    except hf_utils.GatedRepoError:
        print(f"  [403]  {model_name}: gated, using fallback")
    except hf_utils.RepositoryNotFoundError:
        print(f"  [404]  {model_name}: not found ({hf_repo})")
    except Exception as e:
        print(f"  [ERR]  {model_name}: {e}")
    return result

def build_params_map(models, use_hf=True, hf_token=None):
    """
    Resolve parameter counts for all models.
    Returns (params_map, excluded_list).
    """
    params_map, excluded = {}, []
    for model in sorted(models):
        hf_repo = MODEL_HF_REPO.get(model)
        hf_data = (fetch_hf_info(model, hf_repo, token=hf_token)
            if use_hf and hf_repo else {})
        params_B = hf_data.get("params_B")
        if params_B is None and model in MODEL_PARAMS_B_KNOWN:
            params_B = MODEL_PARAMS_B_KNOWN[model]
            src = "known" if not hf_repo else "known (HF empty)"
            print(f"  [OK]   {model}: {params_B}B ({src})")
        if params_B is None:
            print(f"  [SKIP] {model}: excluded (no params)")
            excluded.append(model)
            continue
        params_map[model] = params_B
        if model not in MODEL_DTYPE and hf_data.get("dtype"):
            MODEL_DTYPE[model] = hf_data["dtype"]
        if (model not in MODEL_ACTIVE_PARAMS_B
                and hf_data.get("moe")
                and hf_data.get("n_experts")
                and hf_data.get("top_k")):
            f_moe = 0.85
            eff = round((1 - f_moe) * params_B
                + (hf_data["top_k"] / hf_data["n_experts"]) * f_moe * params_B,
                3)
            MODEL_ACTIVE_PARAMS_B[model] = eff
            print(f"  [MoE]  {model}: eff params auto-set to {eff:.3f}B")
    return params_map, excluded

# 5. Energy and CO2 computation

def _attribution_share(df_period, params_map):
    """
    Compute per-model attribution shares for a given usage period.
    Returns {model: share} dict.  Shares sum to 1.0 for known models.
    """
    p = df_period.copy()
    p["params_B"]     = p["Model"].map(params_map)
    p["eff_params"]   = p["Model"].map(MODEL_ACTIVE_PARAMS_B).combine_first(p["params_B"])
    p["quant_factor"] = p["Model"].map(MODEL_DTYPE).fillna("bf16").map(QUANT_FACTOR).fillna(1.0)
    known = p["params_B"].notna()

    p.loc[known, "vw"] = (
        p.loc[known, "tokens"]
        * p.loc[known, "eff_params"]
        * p.loc[known, "quant_factor"])
    tvw   = p.loc[known, "vw"].sum()
    tdays = p.loc[known, "active_days"].sum()

    if tvw > 0 and tdays > 0:
        p.loc[known, "idle_sh"] = p.loc[known, "active_days"] / tdays
        p.loc[known, "share"]   = (
            (1 - IDLE_POWER_FRACTION) * p.loc[known, "vw"] / tvw
            + IDLE_POWER_FRACTION     * p.loc[known, "idle_sh"])
    else:
        p.loc[known, "share"] = 0.0

    return p[["Model", "share"]].set_index("Model")["share"].to_dict()

def compute(usage, df_dec, df_feb_raw, df_feb_energy_wh, params_map, excluded):
    """
    Compute per-model energy and CO2 for the full Oct-2025/Feb-2026 period.
    Returns (agg_df, energy_info_dict).
    """
    # Dec cluster power from PDU snapshot
    gpu_col = next((c for c in df_dec.columns
         if c in ("GPU", "NODE", "PDU")
         or (df_dec[c].dtype == object and c != "Datetime")),
        None)
    cluster_power_w = df_dec.groupby(gpu_col)["Input Active Power Total (W)"].mean().sum()
    n_gpu_nodes = df_dec[gpu_col].nunique()
    print(f"  Dec cluster power  : {cluster_power_w:,.0f} W ({n_gpu_nodes} nodes)")

    # Dec uptime scenarios
    dates_dec = (usage[usage["Date"] <= "2025-12-31"]["Date"]
                 .drop_duplicates().sort_values())
    n_dec_opt = len(dates_dec)
    n_dec_pes = (dates_dec.max() - dates_dec.min()).days + 1
    n_dec_cen = (n_dec_opt + n_dec_pes) / 2

    def _kwh(power_w, days):
        return power_w * 24 * days / 1000

    energy_it_dec = {
        "optimistic":  _kwh(cluster_power_w, n_dec_opt),
        "central":     _kwh(cluster_power_w, n_dec_cen),
        "pessimistic": _kwh(cluster_power_w, n_dec_pes),}

    # Feb energy
    usage_feb  = usage[(usage["Date"] >= "2026-02-01") & (usage["Date"] <= "2026-02-28")]
    dates_feb  = usage_feb["Date"].drop_duplicates().sort_values()
    n_feb_opt  = len(dates_feb)
    n_feb_pes  = int((dates_feb.max() - dates_feb.min()).days + 1) if len(dates_feb) else 0
    n_feb_cen  = (n_feb_opt + n_feb_pes) / 2

    # Sanity check: ratio > 3 indicates probable double-counting
    _feb_raw = (df_feb_energy_wh / 1000) if df_feb_energy_wh else 0
    _ref     = _kwh(cluster_power_w, n_feb_cen)
    _ratio   = _feb_raw / _ref if _ref > 0 else 0

    print(f"  Feb raw IT energy  : {_feb_raw:,.0f} kWh  (cumulative diff)")
    print(f"  Dec-based reference: {_ref:,.0f} kWh  (cluster power × uptime)")
    print(f"  Ratio raw/ref      : {_ratio:.1f}×  (expected ~1.0, >3 = likely overcount)")

    if df_feb_energy_wh and df_feb_energy_wh > 0:
        if _ratio > 3.0:
            n_circuits = (
                df_feb_raw["ID_Voie"].nunique()
                if df_feb_raw is not None and "ID_Voie" in df_feb_raw.columns
                else 1)
            print(f"  [WARN] Ratio {_ratio:.1f}x > 3 -- probable double-count "
                  f"({n_circuits} circuits). Falling back to Dec reference.")
            feb_method = (f"Dec power reference (overcount guard: "
                          f"ratio={_ratio:.1f}×, circuits={n_circuits})")
            energy_it_feb = {sc: _kwh(cluster_power_w, n)
                             for sc, n in [("optimistic", n_feb_opt),
                                           ("central",    n_feb_cen),
                                           ("pessimistic",n_feb_pes)]}
        else:
            feb_method    = f"direct measurement (cumulative diff): {_feb_raw:,.1f} kWh"
            energy_it_feb = {k: _feb_raw for k in ("optimistic", "central", "pessimistic")}
    else:
        feb_method    = "Dec power reference × uptime scenarios (no Feb PDU data)"
        energy_it_feb = {sc: _kwh(cluster_power_w, n)
                         for sc, n in [("optimistic", n_feb_opt),
                                       ("central",    n_feb_cen),
                                       ("pessimistic",n_feb_pes)]}

    print(f"  Feb energy method  : {feb_method}")
    print(f"  Feb IT energy used : {energy_it_feb['central']:,.0f} kWh (central)")

    energy_it_total  = {k: energy_it_dec[k] + energy_it_feb[k]
                        for k in ("optimistic", "central", "pessimistic")}
    energy_fac_total = {k: v * PUE for k, v in energy_it_total.items()}

    # Aggregate usage
    agg = usage.groupby("Model").agg(
        total_requests=("Requests",     "sum"),
        total_tokens  =("Total Tokens", "sum"),
        total_spend   =("Spend ($)",    "sum"),
        active_days   =("Date",         "nunique"),).reset_index()

    agg["params_B"]      = agg["Model"].map(params_map)
    agg["dtype"]         = agg["Model"].map(MODEL_DTYPE).fillna("bf16")
    agg["quant_factor"]  = agg["dtype"].map(QUANT_FACTOR).fillna(1.0)
    agg["active_params_B"]    = agg["Model"].map(MODEL_ACTIVE_PARAMS_B)
    agg["effective_params_B"] = agg["active_params_B"].combine_first(agg["params_B"])
    known = agg["params_B"].notna()

    # FIX 3: idle
    tot_days = agg.loc[known, "active_days"].sum()
    agg.loc[known, "idle_share"] = agg.loc[known, "active_days"] / tot_days
    agg.loc[known, "variable_weight"] = (
        agg.loc[known, "total_tokens"]
        * agg.loc[known, "effective_params_B"]
        * agg.loc[known, "quant_factor"])
    tvw = agg.loc[known, "variable_weight"].sum()
    agg.loc[known, "variable_share"] = agg.loc[known, "variable_weight"] / tvw
    agg.loc[known, "share"] = (
        (1 - IDLE_POWER_FRACTION) * agg.loc[known, "variable_share"]
        + IDLE_POWER_FRACTION     * agg.loc[known, "idle_share"])

    for sc in ("optimistic", "central", "pessimistic"):
        agg.loc[known, f"energy_fac_kWh_{sc}"] = (
            agg.loc[known, "share"] * energy_fac_total[sc])
        agg.loc[known, f"co2_kg_{sc}"] = (agg.loc[known, f"energy_fac_kWh_{sc}"] * CO2_FACTOR)

    agg.loc[known, "energy_fac_kWh"] = agg.loc[known, "energy_fac_kWh_central"]
    agg.loc[known, "co2_kg"]         = agg.loc[known, "co2_kg_central"]
    agg.loc[known, "kWh_per_1M_tok"] = (
        agg.loc[known, "energy_fac_kWh"]
        / (agg.loc[known, "total_tokens"] / 1e6))
    agg.loc[known, "Wh_per_req"]   = (
        agg.loc[known, "energy_fac_kWh"] * 1000 / agg.loc[known, "total_requests"])
    agg.loc[known, "gCO2_per_req"] = agg.loc[known, "Wh_per_req"] * CO2_FACTOR

    # Per-period attribution (dec / feb split)
    fac_cen = energy_fac_total["central"]
    fac_dec = fac_cen * energy_it_dec["central"] / energy_it_total["central"]
    fac_feb = fac_cen * energy_it_feb["central"] / energy_it_total["central"]

    for period_label, period_df, period_fac in [
        ("dec", usage[usage["Date"] <= "2025-12-31"], fac_dec),
        ("feb", usage_feb, fac_feb),]:
        p = period_df.groupby("Model").agg(
            tokens=(    "Total Tokens", "sum"),
            requests=(  "Requests",     "sum"),
            active_days=("Date",        "nunique"),
        ).reset_index()
        shares = _attribution_share(p, params_map)
        agg[f"energy_{period_label}_kWh"] = agg["Model"].map(shares) * period_fac
        agg[f"co2_{period_label}_kg"]     = (
            agg[f"energy_{period_label}_kWh"] * CO2_FACTOR)

    agg = agg.sort_values(
        "energy_fac_kWh", ascending=False, na_position="last").reset_index(drop=True)

    print("\n  Attribution corrections applied:")
    print(f"    FP8 models       : {agg.loc[agg['dtype']=='fp8', 'Model'].tolist()}")
    print(f"    MXFP4-MoE models : {agg.loc[agg['dtype']=='mxfp4_moe_90pct', 'Model'].tolist()}")
    print(f"    MoE active params: {agg.loc[agg['active_params_B'].notna(), 'Model'].tolist()}")
    print(f"    Idle fraction    : {IDLE_POWER_FRACTION:.0%} via hosting days")

    energy_info = {
        "n_days_dec_opt":      n_dec_opt,
        "n_days_dec_pes":      n_dec_pes,
        "n_days_feb_opt":      n_feb_opt,
        "n_days_feb_pes":      n_feb_pes,
        "cluster_power_dec_w": cluster_power_w,
        "feb_method":          feb_method,
        **{f"energy_it_dec_{k[:3]}":  v for k, v in energy_it_dec.items()},
        **{f"energy_it_feb_{k[:3]}":  v for k, v in energy_it_feb.items()},
        **{f"energy_it_total_{k}":    v for k, v in energy_it_total.items()},
        **{f"energy_fac_total_{k}":   v for k, v in energy_fac_total.items()},}
    return agg, energy_info

def compute_feb_only(usage, df_feb_energy_wh, cluster_power_dec_w, params_map):
    """
    Compute per-model energy and CO2 for February 2026 only.
    Uses direct PDU measurement when available; falls back to Dec power reference.
    Returns a DataFrame (or empty DataFrame if no Feb usage data).
    """
    usage_feb = usage[
        (usage["Date"] >= "2026-02-01") & (usage["Date"] <= "2026-02-28")].copy()

    if len(usage_feb) == 0:
        print("  [WARN] No February usage data found")
        return pd.DataFrame()

    dates_feb = usage_feb["Date"].drop_duplicates().sort_values()
    n_opt = len(dates_feb)
    n_pes = int((dates_feb.max() - dates_feb.min()).days + 1)
    n_cen = (n_opt + n_pes) / 2

    if df_feb_energy_wh and df_feb_energy_wh > 0:
        feb_it_kwh = df_feb_energy_wh / 1000
        method = f"direct PDU diff: {feb_it_kwh:,.1f} kWh IT"
    else:
        feb_it_kwh = cluster_power_dec_w * 24 * n_cen / 1000
        method = f"Dec power × {n_cen:.1f} days: {feb_it_kwh:,.1f} kWh IT"

    feb_fac_kwh = feb_it_kwh * PUE
    feb_co2_kg  = feb_fac_kwh * CO2_FACTOR

    print("\n  Feb-only energy:")
    print(f"    IT energy : {feb_it_kwh:,.1f} kWh  ({method})")
    print(f"    Facility  : {feb_fac_kwh:,.1f} kWh  (×PUE {PUE})")
    print(f"    CO2       : {feb_co2_kg:,.1f} kg CO2e")

    agg = usage_feb.groupby("Model").agg(
        total_requests=("Requests",     "sum"),
        total_tokens  =("Total Tokens", "sum"),
        active_days   =("Date",         "nunique"),).reset_index()

    agg["params_B"]        = agg["Model"].map(params_map)
    agg["dtype"]           = agg["Model"].map(MODEL_DTYPE).fillna("bf16")
    agg["quant_factor"]    = agg["dtype"].map(QUANT_FACTOR).fillna(1.0)
    agg["active_params_B"] = agg["Model"].map(MODEL_ACTIVE_PARAMS_B)
    agg["eff_params_B"]    = agg["active_params_B"].combine_first(agg["params_B"])
    known = agg["params_B"].notna()

    tot_days = agg.loc[known, "active_days"].sum()
    agg.loc[known, "var_weight"] = (
        agg.loc[known, "total_tokens"]
        * agg.loc[known, "eff_params_B"]
        * agg.loc[known, "quant_factor"])
    tvw = agg.loc[known, "var_weight"].sum()
    agg.loc[known, "idle_share"] = agg.loc[known, "active_days"] / tot_days
    agg.loc[known, "var_share"]  = agg.loc[known, "var_weight"] / tvw
    agg.loc[known, "share"] = (
        (1 - IDLE_POWER_FRACTION) * agg.loc[known, "var_share"]
        + IDLE_POWER_FRACTION     * agg.loc[known, "idle_share"])
    agg.loc[known, "energy_fac_kWh"] = agg.loc[known, "share"] * feb_fac_kwh
    agg.loc[known, "co2_kg"]         = agg.loc[known, "energy_fac_kWh"] * CO2_FACTOR
    agg.loc[known, "kWh_per_1M_tok"] = (
        agg.loc[known, "energy_fac_kWh"] / (agg.loc[known, "total_tokens"] / 1e6))
    agg.loc[known, "Wh_per_req"]   = (
        agg.loc[known, "energy_fac_kWh"] * 1000 / agg.loc[known, "total_requests"])
    agg.loc[known, "gCO2_per_req"] = agg.loc[known, "Wh_per_req"] * CO2_FACTOR

    agg = agg[known].sort_values("energy_fac_kWh", ascending=False).reset_index(drop=True)
    agg["feb_it_kwh"]  = feb_it_kwh
    agg["feb_fac_kwh"] = feb_fac_kwh
    agg["feb_co2_kg"]  = feb_co2_kg
    agg["feb_method"]  = method
    agg["n_days_feb"]  = n_cen
    return agg

