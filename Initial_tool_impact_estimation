def plot_results_table(agg, energy_info, fs=None, bucket=None):
    """
    Plot 10: per-model results table (Feb-only view when energy_info signals it).
    Columns: Model | Share | kWh | CO2 | kWh/Mtok | Wh/req | gCO2/req
    """
    _style()
    df = (agg[agg["params_B"].notna()]
          .sort_values("energy_fac_kWh", ascending=False).copy())

    col_labels = ["Model", "Share", "kWh", "CO₂ (kg)", "kWh/Mtok", "Wh/req", "gCO₂/req"]
    rows = []
    for _, r in df.iterrows():
        rows.append([
            short(r["Model"]),
            f"{r['share']*100:.0f}%",
            f"{r['energy_fac_kWh']:,.0f}",
            f"{r['co2_kg']:,.0f}",
            f"{r['kWh_per_1M_tok']:.2f}",
            f"{r['Wh_per_req']:.2f}",
            f"{r['gCO2_per_req']:.3f}",])

    ei      = energy_info
    tot_fac = ei["energy_fac_total_central"]
    tot_co2 = agg["co2_kg"].sum()
    tot_tok = agg["total_tokens"].sum()
    tot_req = agg["total_requests"].sum()
    rows.append([
        "Total", "100%",
        f"{tot_fac:,.0f}", f"{tot_co2:,.0f}",
        f"{tot_fac/(tot_tok/1e6):.2f}",
        f"{tot_fac*1000/tot_req:.2f}",
        f"{tot_fac*1000/tot_req*CO2_FACTOR:.3f}",
    ])

    fig, ax = plt.subplots(figsize=(14, 0.55 * (len(rows) + 2)))
    ax.axis("off")
    fig.patch.set_facecolor("white")
    tbl = ax.table(cellText=rows, colLabels=col_labels,
                   loc="center", cellLoc="right")
    tbl.auto_set_font_size(False)
    tbl.set_fontsize(10)
    tbl.scale(1, 1.6)
    for j in range(len(col_labels)):
        tbl[0, j].set_facecolor(PALETTE[0])
        tbl[0, j].set_text_props(color="white", fontweight="bold")
        tbl[0, j].set_edgecolor("white")
    for i in range(1, len(rows) + 1):
        is_total = i == len(rows)
        for j in range(len(col_labels)):
            cell = tbl[i, j]
            if is_total:
                cell.set_facecolor("#1F6FEB")
                cell.set_text_props(color="white", fontweight="bold")
            elif i % 2 == 0:
                cell.set_facecolor("#EEF3FB")
            else:
                cell.set_facecolor("white")
            cell.set_edgecolor("#CCCCCC")
        tbl[i, 0].set_text_props(ha="left")
    tbl[0, 0].set_text_props(ha="left")

    has_feb = ei.get("n_days_feb_opt", 0) > 0
    has_dec = ei.get("n_days_dec_opt", 0) > 0
    period  = "1--24 Feb 2026" if (has_feb and not has_dec) else "Oct 2025 -- Feb 2026"
    # Detect team-level token export (kWh/Mtok not meaningful in that case)
    tok_unique = df.groupby("Model")["total_tokens"].sum().nunique() if "total_tokens" in df.columns else 1
    team_export_note = "  (*kWh/Mtok: team-level export)" if tok_unique == 1 else ""
    overcount_flag = " ⚠ OVERCOUNT GUARD" if "overcount guard" in ei.get("feb_method", "") else ""
    feb_it  = ei.get("energy_it_total_central", 1)
    feb_fac_share = (
        ei.get("energy_fac_total_central", 0) * ei.get("energy_it_feb_cen", 0) / feb_it
        if feb_it > 0 else 0)
    feb_note = (
        f" | Feb only: {feb_fac_share:,.0f} kWh"
        if has_dec and has_feb else "")
    fig.suptitle(
        f"Results per model -- {period}   "
        f"(facility: {tot_fac:,.0f} kWh | CO₂: {tot_co2:,.0f} kg | "
        f"PUE={PUE} | {CO2_FACTOR} kg/kWh{feb_note}){overcount_flag}{team_export_note}",
        fontsize=11, fontweight="bold", y=0.98,)
    plt.tight_layout()
    # Remove stale PNG before regenerating to avoid serving a cached version
    if os.path.exists("plot10_results_table.png"):
        os.remove("plot10_results_table.png")
    save(fig, "plot10_results_table", fs, bucket)

def plot_corrections_table(agg, fs=None, bucket=None):
    """Plot 11: attribution corrections summary (precision / MoE / idle)."""
    _style()
    fig = plt.figure(figsize=(12, 7))
    fig.patch.set_facecolor("white")

    def _section_table(ax, rows, labels, bbox):
        t = ax.table(cellText=rows, colLabels=labels,
                     loc="lower center", cellLoc="left", bbox=bbox)
        t.auto_set_font_size(False)
        t.set_fontsize(10)
        t.scale(1, 1.5)
        for j in range(len(labels)):
            t[0, j].set_facecolor(PALETTE[0])
            t[0, j].set_text_props(color="white", fontweight="bold")
        for i in range(1, len(rows) + 1):
            bg = "#EEF3FB" if i % 2 == 0 else "white"
            for j in range(len(labels)):
                t[i, j].set_facecolor(bg)
                t[i, j].set_edgecolor("#CCCCCC")

    # Layout (bottom-to-top, leaving 8% at top for suptitle):
    #   ax3 (idle power)  : 0.01 -> 0.26  (height 0.25)
    #   gap                       0.04
    #   ax2 (MoE)         : 0.30 -> 0.57  (height 0.27)
    #   gap                       0.05
    #   ax1 (precision)   : 0.62 -> 0.92  (height 0.30)
    #   suptitle          : y=0.98
    # Each section heading sits at y=1.0 (top of its own axes), not y>1.

