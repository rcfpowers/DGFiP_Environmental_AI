def plot_emissions_by_period(agg, energy_info, fs=None, bucket=None):
    """Plot 5: CO2 per model stacked by period (Dec vs Feb), + period totals."""
    _style()
    df = agg[agg["params_B"].notna()].copy()
    if "co2_dec_kg" not in df.columns:
        df["co2_dec_kg"] = df["co2_kg"] * 0.85
    if "co2_feb_kg" not in df.columns:
        df["co2_feb_kg"] = df["co2_kg"] * 0.15
    df = df.sort_values("co2_kg", ascending=True)
    names   = df["Model"].apply(short).tolist()
    co2_dec = df["co2_dec_kg"].fillna(0).values
    co2_feb = df["co2_feb_kg"].fillna(0).values

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(17, 7),
                                   gridspec_kw={"width_ratios": [3, 1]})
    fig.suptitle("CO2 emissions per model split by period  (central scenario)",
                 fontsize=13, fontweight="bold")
    ax1.barh(names, co2_dec, color=PALETTE[0], label="Oct-Dec 2025",
             edgecolor="white", linewidth=0.4, height=0.6)
    ax1.barh(names, co2_feb, left=co2_dec, color=PALETTE[1], label="Feb 2026",
             edgecolor="white", linewidth=0.4, height=0.6)
    for i, (d, f) in enumerate(zip(co2_dec, co2_feb)):
        ax1.text(d + f + co2_dec.max() * 0.01, i, f"{d+f:,.1f}",
                 va="center", fontsize=8.5)
    ax1.set_xlabel("CO2 (kg CO2e)", fontsize=11)
    ax1.set_title("Per-model split", fontsize=11, fontweight="bold")
    ax1.legend(fontsize=10, loc="lower right")
    ax1.set_xlim(right=(co2_dec + co2_feb).max() * 1.22)

    ei = energy_info
    tot_cen  = ei["energy_fac_total_central"]
    fac_dec  = tot_cen * ei["energy_it_dec_cen"] / ei["energy_it_total_central"]
    fac_feb  = tot_cen * ei["energy_it_feb_cen"] / ei["energy_it_total_central"]
    c_dec    = fac_dec * CO2_FACTOR
    c_feb    = fac_feb * CO2_FACTOR
    ax2.bar(["Oct-Dec\n2025", "Feb\n2026"], [c_dec, c_feb],
            color=[PALETTE[0], PALETTE[1]], edgecolor="white", width=0.5)
    for i, v in enumerate([c_dec, c_feb]):
        ax2.text(i, v + max(c_dec, c_feb) * 0.02, f"{v:,.0f} kg",
                 ha="center", fontsize=10, fontweight="bold")
    ax2.set_ylabel("CO2 (kg CO2e)", fontsize=10)
    ax2.set_title("Period totals\n(cluster)", fontsize=11, fontweight="bold")
    ax2.set_ylim(top=max(c_dec, c_feb) * 1.28)
    plt.tight_layout()
    save(fig, "plot5_emissions_by_period", fs, bucket)

