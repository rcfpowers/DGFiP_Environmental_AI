def plot_donut_energy(agg, energy_info, fs=None, bucket=None):
    """
    Plot 12: donut chart -- facility energy share per model + KPI breakdown panel.
    """
    _style()
    ei     = energy_info
    df     = (agg[agg["params_B"].notna()]
              .sort_values("energy_fac_kWh", ascending=False).copy())
    vals   = df["energy_fac_kWh"].values
    names  = df["Model"].apply(short).tolist()
    colors = [PALETTE[i % len(PALETTE)] for i in range(len(df))]

    tot_fac  = ei["energy_fac_total_central"]
    # it_kwh is always derived from tot_fac to stay consistent with
    # whichever period (Feb-only or Oct-Feb) the caller passed in.
    # Using energy_it_total_central would give Oct-Feb totals even in
    # the Feb-only view, producing percentages > 100%.
    it_kwh   = tot_fac / PUE
    overhead = tot_fac - it_kwh   # = it_kwh * (PUE - 1)
    tot_co2  = agg["co2_kg"].sum()
    car_km   = tot_co2 / 0.12

    fig = plt.figure(figsize=(16, 7))
    fig.patch.set_facecolor("white")
    has_dec = ei.get("n_days_dec_opt", 0) > 0
    period  = "1--24 Feb 2026" if not has_dec else "Oct 2025 -- Feb 2026"

    # ── Figure layout 
    # Leave the top 12% of the figure for the suptitle (y goes 0..1 bottom-up).
    # Axes start at y=0.05 and end at y=0.88 to give the title room above.
    TOP    = 0.88
    BOTTOM = 0.05

    fig.suptitle(
        f"Energy distribution -- central scenario   |   {period}   |   "
        f"facility energy (kWh, PUE = {PUE:.1f})",
        fontsize=11, fontweight="bold",
        x=0.5, y=0.97, ha="center",)

    # ── Left panel: donut 
    ax_donut = fig.add_axes([0.01, BOTTOM, 0.52, TOP - BOTTOM])
    ax_donut.set_title("A   Facility energy share per model",
                       fontsize=10, fontweight="bold", loc="left", pad=6)
    wedges, _ = ax_donut.pie(
        vals, colors=colors, startangle=90,
        wedgeprops=dict(width=0.55, edgecolor="white", linewidth=1.5),
        counterclock=False,)
    ax_donut.text(0, 0, f"{tot_fac:,.0f}\nkWh total",
                  ha="center", va="center", fontsize=13, fontweight="bold",
                  color="#1A2332")
    ax_donut.legend(
        wedges, [f"{n}  {v/tot_fac*100:.1f}%" for n, v in zip(names, vals)],
        loc="lower left", fontsize=8.5,
        bbox_to_anchor=(-0.18, -0.12), frameon=True,
        title="Model", title_fontsize=9,)

    # ── Right panel: KPI cards 
    ax_kpi = fig.add_axes([0.56, BOTTOM, 0.42, TOP - BOTTOM])
    ax_kpi.axis("off")
    ax_kpi.set_title("B   Facility energy breakdown",
                     fontsize=10, fontweight="bold", loc="left", pad=6)

    # Mini donut: IT vs overhead
    # Position relative to figure (not ax_kpi) to avoid clipping
    ax_mini = fig.add_axes([0.60, 0.48, 0.19, 0.38])
    ax_mini.pie(
        [it_kwh, overhead], colors=["#4C72B0", "#DD8452"],
        startangle=90,
        wedgeprops=dict(width=0.50, edgecolor="white", linewidth=1.5),
        counterclock=False,)
    ax_mini.text(0, 0, f"IT: {it_kwh/tot_fac*100:.0f}%\nOH: {overhead/tot_fac*100:.0f}%",
                 ha="center", va="center", fontsize=8, color="#333333")

    # Annotations to the right of the mini donut
    ax_kpi.text(0.52, 0.91,
                f"IT {it_kwh:,.0f} kWh  ({it_kwh/tot_fac*100:.0f}%)",
                transform=ax_kpi.transAxes, fontsize=9, color="#4C72B0")
    ax_kpi.text(0.52, 0.81,
                f"Overhead {overhead:,.0f} kWh  ({overhead/tot_fac*100:.0f}%)",
                transform=ax_kpi.transAxes, fontsize=9, color="#DD8452")

    # KPI cards (3 coloured boxes)
    for idx, (label, value, color) in enumerate([
        ("Total facility energy", f"{tot_fac:,.0f} kWh",    "#1F6FEB"),
        ("Total CO₂",            f"{tot_co2:,.0f} kg CO₂e", "#E03C3C"),
        ("Equiv. car distance",  f"≈ {car_km:,.0f} km",     "#2BA84A"),
    ]):
        y = 0.38 - idx * 0.16
        ax_kpi.add_patch(plt.Rectangle(
            (0.0, y - 0.04), 0.96, 0.12,
            transform=ax_kpi.transAxes, facecolor=color, alpha=0.10, clip_on=False,
        ))
        ax_kpi.text(0.03, y + 0.04, label, transform=ax_kpi.transAxes,
                    fontsize=9, color="#555555")
        ax_kpi.text(0.03, y - 0.01, value, transform=ax_kpi.transAxes,
                    fontsize=14, fontweight="bold", color=color)

    if os.path.exists("plot12_donut_energy.png"):
        os.remove("plot12_donut_energy.png")
    save(fig, "plot12_donut_energy", fs, bucket)

# 7. Summary

def print_summary(agg, energy_info):
    ei        = energy_info
    tot_req   = agg["total_requests"].sum()
    tot_tok   = agg["total_tokens"].sum()
    tot_spend = agg["total_spend"].sum()
    n_known   = agg["params_B"].notna().sum()
    n_missing = agg["params_B"].isna().sum()

    print("=" * 78)
    print("SUMMARY -- DIANE Energy Analysis  (Oct 2025 -- Feb 2026)")
    print("=" * 78)
    print(f"  Models resolved        : {n_known} / {len(agg)}")
    print(f"  Total requests         : {tot_req:,.0f}")
    print(f"  Total tokens           : {tot_tok/1e9:.2f} billion")
    print(f"  Total spend            : ${tot_spend:,.2f}")
    print(f"  Feb energy method      : {ei.get('feb_method', '?')}")
    print()
    print("  --- February 2026 results ---")
    print("-" * 78)
    for label, opt, cen, pes, fmt in [
        ("Dec uptime (days)",
         ei["n_days_dec_opt"], n_cen(ei["n_days_dec_opt"], ei["n_days_dec_pes"]),
         ei["n_days_dec_pes"], "{:>13.0f}"),
        ("Feb uptime (days)",
         ei["n_days_feb_opt"], n_cen(ei["n_days_feb_opt"], ei["n_days_feb_pes"]),
         ei["n_days_feb_pes"], "{:>13.0f}"),
        ("Dec IT energy (kWh)",
         ei["energy_it_dec_opt"], ei["energy_it_dec_cen"], ei["energy_it_dec_pes"],
         "{:>13,.0f}"),
        ("Feb IT energy (kWh)",
         ei["energy_it_feb_opt"], ei["energy_it_feb_cen"], ei["energy_it_feb_pes"],
         "{:>13,.0f}"),
        ("Total facility energy (kWh)",
         ei["energy_fac_total_optimistic"], ei["energy_fac_total_central"],
         ei["energy_fac_total_pessimistic"], "{:>13,.0f}"),
        ("Total CO2 (kg CO2e)",
         agg["co2_kg_optimistic"].sum(), agg["co2_kg"].sum(),
         agg["co2_kg_pessimistic"].sum(), "{:>13,.1f}"),
        ("Equiv. car distance (km)",
         agg["co2_kg_optimistic"].sum() / 0.12, agg["co2_kg"].sum() / 0.12,
         agg["co2_kg_pessimistic"].sum() / 0.12, "{:>13,.0f}"),]:
        print(f"  {label:<34s} {fmt.format(opt)} {fmt.format(cen)} {fmt.format(pes)}")

    print("-" * 78)
    e = ei["energy_fac_total_central"]
    print(f"\n  Efficiency (central): {e*1000/tot_req:.4f} Wh/req | "
          f"{e/(tot_tok/1e6):.2f} kWh/Mtok | {e/tot_spend:.1f} kWh/$")
    print("=" * 78)
    if n_missing:
        print(f"\n  [WARN] {n_missing} model(s) excluded: "
              f"{agg[agg['params_B'].isna()]['Model'].tolist()}")

# 8. Main

def main(use_hf=True, export=True, hf_token=None):
    sep = "=" * 60
    print(sep); print("DIANE Energy Analysis (Onyxia / S3)"); print(sep)

    # ── [0] Credentials and S3 connection 
    print("\n[0/7] Connecting to S3...")
    _check_credentials()
    fs = get_fs()
    print(f"  s3://{S3_BUCKET}  |  endpoint: {os.environ.get('S3_ENDPOINT', '?')}")

    # ── [1] Load all data 
    print(f"\n[1/7] Loading data from s3://{S3_BUCKET}/{S3_SUBFOLDER.strip()} ...")
    available   = list_data_files(fs)
    local_files = {}

    # Primary: extract from zip
    if any(f.strip() == ZIP_FILENAME.strip() for f in available):
        print(f"\n  Zip found: {ZIP_FILENAME}")
        local_files = download_and_extract_zip(fs)
    else:
        print("  [INFO] Zip not found -- loading CSVs directly from S3")

    # Usage
    usage = load_csv_local(local_files) if local_files else None
    if usage is None:
        # Fallback: direct S3 read
        dfs = []
        for fname in USAGE_FILES:
            fpath = (s3_path(fname) if fname in available
                     else next(
                         (s3_path(k) for k in available
                          if fname.lower().replace(" ", "") in k.lower().replace(" ", "")),
                         None))
            if fpath:
                try:
                    with fs.open(fpath) as fh:
                        df = pd.read_csv(fh)
                    print(f"  Loaded: {fname} ({len(df):,} rows)")
                    dfs.append(df)
                except Exception as e:
                    print(f"  [ERR] {fname}: {e}")
        if dfs:
            usage = pd.concat(dfs, ignore_index=True)
            usage.columns     = usage.columns.str.strip()
            usage["Date"]         = pd.to_datetime(usage["Date"])
            usage["Total Tokens"] = pd.to_numeric(usage["Total Tokens"], errors="coerce").fillna(0)
            usage["Requests"]     = pd.to_numeric(usage["Requests"],     errors="coerce").fillna(0)
            usage["Spend ($)"]    = pd.to_numeric(usage["Spend ($)"],    errors="coerce").fillna(0)
            usage = usage.drop_duplicates(subset=["Date", "Model"]).reset_index(drop=True)

    if usage is None or len(usage) == 0:
        raise FileNotFoundError(
            f"No usage data loaded.\n"
            f"Files in s3://{S3_BUCKET}/{S3_SUBFOLDER.strip()}: {list(available.keys())}")
    print(f"  Usage: {len(usage):,} rows | {usage['Model'].nunique()} models | "
          f"{usage['Date'].min().date()} -> {usage['Date'].max().date()}")

    # Dec energy
    dec_local = local_files.get(ENERGY_FILE_DEC)
    if dec_local:
        print(f"  Loading Dec energy from zip: {ENERGY_FILE_DEC}")
        df_dec = load_energy_dec(None, None, dec_local, local=True)
    else:
        df_dec = load_energy_dec(fs, "", s3_path(ENERGY_FILE_DEC))

    # Feb energy
    feb_local = local_files.get(ENERGY_FILE_FEB)
    if feb_local:
        print(f"  Loading Feb energy from zip: {ENERGY_FILE_FEB}")
        df_feb_raw, df_feb_energy_wh, _ = load_energy_feb(
            None, None, feb_local, local=True)
    else:
        df_feb_raw, df_feb_energy_wh, _ = load_energy_feb(
            fs, "", s3_path(ENERGY_FILE_FEB))

    # ── [1b] PDU circuit files → unified dataset 
    print("\n[1b/7] Loading PDU circuit files & building unified dataset...")
    if local_files:
        df_pdu = _load_pdu_files_local(local_files)
    else:
        df_pdu = _load_pdu_files_s3(fs, available)

    if df_pdu.empty:
        print("  [WARN] No PDU circuit files found -- unified dataset will lack energy columns")

    unified = build_unified_dataset(fs, S3_BUCKET, usage, df_pdu)
    print(f"  Unified dataset: {len(unified):,} rows | {len(unified.columns)} cols")

    # ── [2] Model parameters
    mode_str = "HF+fallback" if use_hf else "fallback only"
    print(f"\n[2/7] Resolving model parameters ({mode_str})...")
    params_map, excluded = build_params_map(
        sorted(usage["Model"].unique()), use_hf=use_hf, hf_token=hf_token)
    print(f"  Resolved: {len(params_map)} | Excluded: {len(excluded)}")

    # ── [3] Energy and CO2 computation (February only) 
    print("\n[3/7] Computing Feb energy & CO2...")
    agg_feb = compute_feb_only(
        usage, df_feb_energy_wh,
        cluster_power_dec_w=df_dec.groupby(
            next(c for c in df_dec.columns
                 if c in ("GPU","NODE","PDU")
                 or (df_dec[c].dtype == object and c != "Datetime"))
        )["Input Active Power Total (W)"].mean().sum(),
        params_map=params_map,)
    if agg_feb.empty:
        raise RuntimeError("compute_feb_only returned empty -- check February usage data.")
    feb_fac_v = agg_feb["feb_fac_kwh"].iloc[0]
    feb_co2_v = agg_feb["feb_co2_kg"].iloc[0]
    print(f"  Feb facility energy: {feb_fac_v:,.0f} kWh | CO2: {feb_co2_v:,.0f} kg")
    # Build energy_info dict expected by summary and remaining plots
    ei = {
        "energy_fac_total_central":  feb_fac_v,
        "energy_it_total_central":   feb_fac_v / PUE,
        "energy_it_feb_cen":         feb_fac_v / PUE,
        "energy_it_dec_cen":         0,
        "energy_fac_total_optimistic": feb_fac_v,
        "energy_fac_total_pessimistic":feb_fac_v,
        "n_days_dec_opt": 0, "n_days_dec_pes": 0,
        "n_days_feb_opt": int(agg_feb["n_days_feb"].iloc[0]),
        "n_days_feb_pes": int(agg_feb["n_days_feb"].iloc[0]),
        "cluster_power_dec_w": df_dec.groupby(
            next(c for c in df_dec.columns
                 if c in ("GPU","NODE","PDU")
                 or (df_dec[c].dtype == object and c != "Datetime"))
        )["Input Active Power Total (W)"].mean().sum(),
        "feb_method": agg_feb["feb_method"].iloc[0],}
    agg = agg_feb.copy()  # all downstream code uses agg
    # add scenario columns expected by print_summary
    for sc in ("optimistic", "central", "pessimistic"):
        agg[f"co2_kg_{sc}"] = agg["co2_kg"]
        agg[f"energy_fac_kWh_{sc}"] = agg["energy_fac_kWh"]
    energy_info = ei

    # ── [4] Summary
    print("\n[4/7] Summary...")
    print_summary(agg, energy_info)

    # ── [5] Plots 
    print("\n[5/7] Generating 3 charts (10, 11, 12)...")
    bucket_out = S3_BUCKET if export else None
    # Plots 1-9 are available as standalone functions but not generated by default.
    # Only plots 10, 11, 12 are generated: results table, corrections, donut.
    _ei_feb = {
        "energy_fac_total_central":  ei["energy_fac_total_central"],
        "energy_it_total_central":   ei["energy_it_total_central"],
        "energy_it_feb_cen":         ei["energy_it_feb_cen"],
        "n_days_feb_opt":            ei["n_days_feb_opt"],
        "n_days_dec_opt":            0,
        "feb_method":                ei["feb_method"],
        "cluster_power_dec_w":       ei["cluster_power_dec_w"],}
    plot_results_table(agg, _ei_feb, fs, bucket_out)
    plot_corrections_table(agg, fs, bucket_out)
    plot_donut_energy(agg, _ei_feb, fs, bucket_out)

    # ── [6] Export
    if export:
        print("\n[6/7] Exporting to S3...")
        with fs.open(f"{S3_BUCKET}/{OUTPUT_CSV}", "w") as f:
            agg.to_csv(f, index=False)
        with fs.open(f"{S3_BUCKET}/{OUTPUT_SUMMARY}", "w") as f:
            pd.DataFrame([energy_info]).to_csv(f, index=False)
        print(f"  -> s3://{S3_BUCKET}/{OUTPUT_CSV}")
        print(f"  -> s3://{S3_BUCKET}/{OUTPUT_SUMMARY}")
    else:
        print("\n[6/7] Export skipped (--no-export)")

    print("\n[7/7] Done.")
    return agg, energy_info

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="DIANE -- per-model energy & CO2 estimation")
    parser.add_argument("--no-hf",     action="store_true",
                        help="Skip HuggingFace lookup, use hardcoded values only")
    parser.add_argument("--no-export", action="store_true",
                        help="Skip writing results and plots to S3")
    parser.add_argument("--hf-token",  default=None,
                        help="HuggingFace API token (for gated models)")
    args, _ = parser.parse_known_args()
    main(use_hf=not args.no_hf, export=not args.no_export, hf_token=args.hf_token)
