def plot_attribution_corrections(agg, fs=None, bucket=None):
    """Plot 8: naive vs corrected attribution share -- shows impact of 3 FIXes."""
    _style()
    df = agg[agg["params_B"].notna()].copy()
    df["naive_weight"] = df["total_tokens"] * df["params_B"]
    df["naive_share"]  = df["naive_weight"] / df["naive_weight"].sum()
    df = df.sort_values("naive_share", ascending=True)
    n = len(df)
    y = np.arange(n)
    h = 0.35
    fig, ax = plt.subplots(figsize=(13, 7))
    ax.barh(y - h/2, df["naive_share"] * 100, h, color=C_MUTED, alpha=0.7,
            label="Naive (total params only)", edgecolor="white")
    ax.barh(y + h/2, df["share"] * 100, h,
            color=[PALETTE[i % len(PALETTE)] for i in range(n)],
            label="Corrected (eff. params + quant + idle)", edgecolor="white")
    for i, row in df.reset_index(drop=True).iterrows():
        delta = (row["share"] - row["naive_share"]) * 100
        col   = PALETTE[2] if delta > 0 else PALETTE[3]
        ax.text(
            max(row["naive_share"], row["share"]) * 100 + 0.3,
            i, f"{delta:+.1f}pp", va="center", fontsize=8, color=col,)
    ax.set_yticks(y)
    ax.set_yticklabels(df["Model"].apply(short).tolist(), fontsize=9)
    ax.set_xlabel("Attribution share (%)", fontsize=11)
    ax.set_title(
        "Attribution correction impact\n"
        "(naive vs corrected: MoE + quantisation + idle power)",
        fontsize=12, fontweight="bold",)
    ax.legend(fontsize=10)
    plt.tight_layout()
    save(fig, "plot8_attribution_corrections", fs, bucket)

