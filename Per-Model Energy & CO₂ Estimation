# 0. Install dependencies
# ==============================================================================
import subprocess, sys

def install():
    pkgs = ["pandas", "numpy", "matplotlib", "huggingface_hub", "boto3", "s3fs"]
    print("Installing dependencies...")
    subprocess.check_call([sys.executable, "-m", "pip", "install", "--quiet"] + pkgs)
    print("OK\n")

install()

