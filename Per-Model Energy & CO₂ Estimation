# 7. Summary
# ==============================================================================

def print_summary(agg, uptime):
    """Print a summary table with all three uptime scenarios."""
    u          = uptime
    tot_req    = agg["total_requests"].sum()
    tot_tok    = agg["total_tokens"].sum()
    tot_spend  = agg["total_spend"].sum()
    n_known    = agg["params_B"].notna().sum()
    n_missing  = agg["params_B"].isna().sum()

    print("=" * 65)
    print("SUMMARY – DIANE Energy Analysis")
    print("=" * 65)
    print(f"Models with known parameters  : {n_known} / {len(agg)}")
    print(f"Total requests                : {tot_req:,.0f}")
    print(f"Total tokens                  : {tot_tok/1e9:.2f} billion")
    print(f"Total spend                   : ${tot_spend:,.2f}")
    print()
    h = f"{'':32s} {'Optimistic':>12} {'Central':>12} {'Pessimistic':>13}"
    s = f"{'':32s} {'(off w/o traffic)':>12} {'(average)':>12} {'(24/7)':>13}"
    print(h)
    print(s)
    print("-" * 72)

    rows = [
        ("Uptime (days)",
         u["n_days_optimistic"], (u["n_days_optimistic"]+u["n_days_pessimistic"])//2,
         u["n_days_pessimistic"], "{:>12.0f}"),
        ("IT energy (kWh)",
         u["energy_it_optimistic"], u["energy_it_central"], u["energy_it_pessimistic"],
         "{:>12,.0f}"),
        ("Facility energy (kWh)",
         u["energy_fac_optimistic"], u["energy_fac_central"], u["energy_fac_pessimistic"],
         "{:>12,.0f}"),
        ("CO₂ (kg)",
         agg["co2_kg_optimistic"].sum(), agg["co2_kg"].sum(),
         agg["co2_kg_pessimistic"].sum(), "{:>12,.1f}"),
        ("Equiv. car distance (km)",
         agg["co2_kg_optimistic"].sum()/120, agg["co2_kg"].sum()/120,
         agg["co2_kg_pessimistic"].sum()/120, "{:>12,.0f}"),
    ]
    for label, opt, cen, pes, fmt in rows:
        print(f"  {label:<30s} {fmt.format(opt)} {fmt.format(cen)} {fmt.format(pes)}")

    print("-" * 72)
    e = u["energy_fac_central"]
    print(f"\nEfficiency metrics (central scenario):")
    print(f"  Per request (avg)     : {e*1000/tot_req:.4f} Wh")
    print(f"  Per million tokens    : {e/(tot_tok/1e6):.2f} kWh")
    print(f"  Per dollar spent      : {e/tot_spend:.1f} kWh/$")
    print("=" * 65)
    print()
    print("KNOWN LIMITATIONS:")
    print(f"  - PDU measurement covers only 80 min (3 Dec 2025) – assumed representative")
    print(f"  - Real uptime unknown: range is {u['n_days_optimistic']}–{u['n_days_pessimistic']} days")
    print(f"  - PUE = {PUE} is an estimate; actual datacenter value unknown")
    print(f"  - Energy attribution uses tokens × params proxy, not direct measurement")
    if n_missing > 0:
        missing = agg[agg["params_B"].isna()]["Model"].tolist()
        print(f"  - {n_missing} model(s) excluded (missing parameter data): {missing}")

# ==============================================================================
# MAIN
# ==============================================================================

def main(use_hf=True, export=True):
    sep = "=" * 55
    print(sep)
    print("DIANE Energy Analysis (Onyxia / S3)")
    print(sep)

    print("\n[0/6] Connecting to S3...")
    fs = get_fs()
    print(f"  Bucket   : s3://{S3_BUCKET}")
    print(f"  Endpoint : {os.environ.get('S3_ENDPOINT', '?')}")

    print("\n[1/6] Loading data from S3...")
    usage  = load_usage(fs, S3_BUCKET, USAGE_FILES)
    energy = load_energy(fs, S3_BUCKET, ENERGY_FILE)
    print(f"  Usage  : {len(usage):,} rows | {usage['Model'].nunique()} models | "
          f"{usage['Date'].min().date()} → {usage['Date'].max().date()}")
    print(f"  Energy : {len(energy):,} rows | {energy['GPU'].nunique()} GPU nodes")

    print(f"\n[2/6] Looking up model parameters "
          f"{'(HuggingFace + fallback)' if use_hf else '(fallback only)'}...")
    models = sorted(usage["Model"].unique())
    params_map, excluded = build_params_map(models, use_hf)
    print(f"  Models with data : {len(params_map)} | Excluded : {len(excluded)}")

    print("\n[3/6] Computing energy estimates...")
    agg, power_per_gpu, cluster_power_w, uptime = compute(
        usage, energy, params_map, excluded
    )
    u = uptime
    print(f"  Cluster power      : {cluster_power_w:.0f} W ({cluster_power_w/1000:.2f} kW IT)")
    print(f"  Facility power     : {cluster_power_w*PUE:.0f} W (PUE {PUE})")
    print(f"  Optimistic scenario: {u['n_days_optimistic']} days → "
          f"{u['energy_fac_optimistic']:,.0f} kWh facility")
    print(f"  Pessimistic scenario: {u['n_days_pessimistic']} days → "
          f"{u['energy_fac_pessimistic']:,.0f} kWh facility")

    print("\n[4/6] Summary...")
    print_summary(agg, uptime)

    print("\n[5/6] Generating charts...")
    plot_power_realtime(energy)
    plot_energy_by_model(agg)
    plot_pie(agg, u["energy_it_central"])

    if export:
        print("\n[6/6] Exporting results to S3...")
        out_path = f"{S3_BUCKET}/{OUTPUT_CSV}"
        with fs.open(out_path, "w") as f:
            agg.to_csv(f, index=False)
        print(f"  → s3://{out_path}")
        scenarios_df = pd.DataFrame([uptime])
        with fs.open(f"{S3_BUCKET}/energy_uptime_scenarios.csv", "w") as f:
            scenarios_df.to_csv(f, index=False)
        print(f"  → s3://{S3_BUCKET}/energy_uptime_scenarios.csv")
    else:
        print("\n[6/6] Export skipped (--no-export)")

    print("\nDone.")
    return agg


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="DIANE Energy Analysis – Per-Model Energy & CO₂ Estimation"
    )
    parser.add_argument("--no-hf",     action="store_true",
                        help="Skip HuggingFace lookup, use known values only")
    parser.add_argument("--no-export", action="store_true",
                        help="Do not write results to S3")
    args, _ = parser.parse_known_args()
    main(use_hf=not args.no_hf, export=not args.no_export)
