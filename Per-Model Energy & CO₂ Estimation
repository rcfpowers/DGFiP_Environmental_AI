# 6. Plots
# ==============================================================================

def short(name):
    """Shorten model names for chart labels."""
    return (name.replace("/model/", "")
                .replace("-Instruct", "").replace("-instruct", "")
                .replace("-fp8-W8A16", "").replace("-FP8-dynamic", "")
                .replace("-2501", ""))


def plot_power_realtime(energy):
    """Plot real-time GPU power from PDU readings."""
    fig, ax = plt.subplots(figsize=(13, 4))
    for gpu in sorted(energy["GPU"].unique()):
        sub = energy[energy["GPU"] == gpu].sort_values("Datetime")
        ax.plot(sub["Datetime"], sub["Input Active Power Total (W)"],
                linewidth=1.5, label=gpu)
    total = energy.groupby("Datetime")["Input Active Power Total (W)"].sum()
    ax2 = ax.twinx()
    ax2.plot(total.index, total.values, color="black", linewidth=2.5,
             linestyle="--", label="Total cluster")
    ax2.set_ylabel("Total cluster power (W)")
    ax.set_title(
        "Real-time GPU power per node – 3 Dec 2025 (PDU readings every 5 min)",
        fontsize=12
    )
    ax.set_ylabel("Power per node (W)")
    ax.xaxis.set_major_formatter(mdates.DateFormatter("%H:%M"))
    ax.legend(loc="upper left", fontsize=8)
    ax2.legend(loc="upper right", fontsize=9)
    ax.grid(True, linestyle=":", alpha=0.5)
    plt.tight_layout()
    plt.savefig("plot_power_realtime.png", dpi=150, bbox_inches="tight")
    plt.show()
    print("  → plot_power_realtime.png")


def plot_energy_by_model(agg):
    """4-panel chart: total energy, total CO2, efficiency, CO2 per request."""
    df = agg[agg["params_B"].notna()].copy()
    fig, axes = plt.subplots(2, 2, figsize=(16, 11))
    fig.suptitle(
        f"DIANE – Energy consumption & CO₂ per model  "
        f"(PUE={PUE}, {CO2_FACTOR} kg CO₂/kWh, central scenario)",
        fontsize=13, fontweight="bold"
    )
    panels = [
        (axes[0,0], "energy_fac_kWh", "kWh (facility, PUE 1.7)",
         "Total energy consumed",          "{:,.0f}"),
        (axes[0,1], "co2_kg",          "kg CO₂e",
         "Total carbon footprint",         "{:,.1f}"),
        (axes[1,0], "kWh_per_1M_tok",  "kWh / million tokens",
         "Energy efficiency (↓ = better)", "{:,.2f}"),
        (axes[1,1], "gCO2_per_req",    "g CO₂e per request",
         "CO₂ per request",               "{:,.3f}"),
    ]
    for ax, col, xlabel, title, fmt in panels:
        sub    = df.dropna(subset=[col])
        names  = sub["Model"].apply(short)
        colors = plt.cm.RdYlGn_r(np.linspace(0.15, 0.85, len(sub)))
        bars   = ax.barh(names, sub[col], color=colors)
        ax.set_xlabel(xlabel)
        ax.set_title(title)
        ax.bar_label(bars, labels=[fmt.format(v) for v in sub[col]],
                     padding=3, fontsize=8)
        ax.grid(axis="x", linestyle=":", alpha=0.5)
    plt.tight_layout()
    plt.savefig("plot_energy_by_model.png", dpi=150, bbox_inches="tight")
    plt.show()
    print("  → plot_energy_by_model.png")


def plot_pie(agg, energy_it_central_kwh):
    """Pie charts: share per model + IT vs datacenter overhead."""
    df = agg[agg["params_B"].notna()].copy()
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))
    fig.suptitle("Energy distribution across the cluster", fontsize=13, fontweight="bold")

    labels = df["Model"].apply(short)
    ax1.pie(df["energy_fac_kWh"], labels=labels, autopct="%1.1f%%",
            startangle=90, colors=plt.cm.tab10.colors[:len(df)])
    ax1.set_title("Facility energy share per model")

    overhead = energy_it_central_kwh * (PUE - 1)
    ax2.pie(
        [energy_it_central_kwh, overhead],
        labels=[
            f"IT servers\n{energy_it_central_kwh:,.0f} kWh",
            f"Datacenter overhead\n(cooling, UPS, etc.)\n{overhead:,.0f} kWh",
        ],
        autopct="%1.1f%%", startangle=90, colors=["#4C72B0", "#DD8452"]
    )
    ax2.set_title(f"IT vs Overhead (PUE = {PUE})")
    plt.tight_layout()
    plt.savefig("plot_energy_split.png", dpi=150, bbox_inches="tight")
    plt.show()
    print("  → plot_energy_split.png")

