# ==============================================================================
# 2. S3 connection
# ==============================================================================

def get_fs():
    """
    Connect to S3 using credentials injected by Onyxia into the environment.
    Variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
               S3_ENDPOINT, AWS_DEFAULT_REGION.
    """
    endpoint = os.environ.get("S3_ENDPOINT") or os.environ.get("AWS_S3_ENDPOINT")
    if not endpoint:
        raise EnvironmentError(
            "S3_ENDPOINT not found. Run this script from an Onyxia service "
            "or set the environment variable manually."
        )
    return s3fs.S3FileSystem(
        key=os.environ.get("AWS_ACCESS_KEY_ID"),
        secret=os.environ.get("AWS_SECRET_ACCESS_KEY"),
        token=os.environ.get("AWS_SESSION_TOKEN"),
        endpoint_url=endpoint,
        client_kwargs={"region_name": os.environ.get("AWS_DEFAULT_REGION", "us-east-1")},
    )

# ==============================================================================
# 3. Model parameter lookup via HuggingFace
# ==============================================================================

def fetch_hf_params(model_name, hf_repo):
    """
    Query HuggingFace Hub for the exact number of parameters.
    Returns value in billions, or None if not found.
    Sources checked in order: safetensors metadata → config.
    """
    try:
        from huggingface_hub import HfApi
        info = HfApi().model_info(hf_repo)
        if info.safetensors and info.safetensors.total:
            p = info.safetensors.total / 1e9
            print(f"  [HF]   {model_name}: {p:.3f}B (safetensors)")
            return p
        config = getattr(info, "config", None) or {}
        if "num_parameters" in config:
            p = config["num_parameters"] / 1e9
            print(f"  [HF]   {model_name}: {p:.3f}B (config)")
            return p
        print(f"  [--]   {model_name}: no parameter data on HF ({hf_repo})")
        return None
    except Exception as e:
        print(f"  [ERR]  {model_name}: HF error → {e}")
        return None


def build_params_map(models, use_hf):
    """
    Build a {model_name: params_B} map for all models in the dataset.

    Priority for each model:
      1. HuggingFace Hub (if use_hf=True and repo is mapped)
      2. MODEL_PARAMS_B_KNOWN (manually verified values)
      3. Excluded – no value invented, results will show NaN
    """
    params_map = {}
    excluded = []
    for model in sorted(models):
        hf_repo = MODEL_HF_REPO.get(model)
        if use_hf and hf_repo:
            val = fetch_hf_params(model, hf_repo)
            if val is not None:
                params_map[model] = val
                continue
        if model in MODEL_PARAMS_B_KNOWN:
            src = "known" if not hf_repo else "known (HF has no safetensors)"
            print(f"  [OK]   {model}: {MODEL_PARAMS_B_KNOWN[model]}B ({src})")
            params_map[model] = MODEL_PARAMS_B_KNOWN[model]
            continue
        reason = "internal model" if not hf_repo else "not found on HF"
        print(f"  [SKIP] {model}: excluded ({reason})")
        excluded.append(model)
    return params_map, excluded

# ==============================================================================
# 4. Load data from S3
# ==============================================================================

def load_usage(fs, bucket, files):
    """Load and concatenate usage CSV files from S3."""
    dfs = []
    for f in files:
        print(f"  Reading: s3://{bucket}/{f}")
        with fs.open(f"{bucket}/{f}") as fh:
            dfs.append(pd.read_csv(fh))
    usage = pd.concat(dfs, ignore_index=True)
    usage.columns = usage.columns.str.strip()
    usage["Date"]         = pd.to_datetime(usage["Date"])
    usage["Total Tokens"] = pd.to_numeric(usage["Total Tokens"], errors="coerce").fillna(0)
    usage["Requests"]     = pd.to_numeric(usage["Requests"],     errors="coerce").fillna(0)
    usage["Spend ($)"]    = pd.to_numeric(usage["Spend ($)"],    errors="coerce").fillna(0)
    return usage


def load_energy(fs, bucket, energy_file):
    """Load GPU power measurements from S3."""
    print(f"  Reading: s3://{bucket}/{energy_file}")
    with fs.open(f"{bucket}/{energy_file}") as fh:
        df = pd.read_csv(fh)
    df["Input Active Power Total (W)"] = pd.to_numeric(
        df["Input Active Power Total (W)"], errors="coerce"
    )
    df["Datetime"] = pd.to_datetime(df["Datetime"], utc=True)
    return df

# ==============================================================================
# 5. Energy calculations
# ==============================================================================

def compute(usage, energy, params_map, excluded):
    """
    Compute energy and CO2 per model.

    Method:
      - Cluster power: average of PDU readings across all 6 GPU nodes
      - Total energy: cluster_power × 24h × uptime_days
      - Uptime uncertainty: two scenarios shown side by side
          · Optimistic  – only days with recorded requests (cluster off otherwise)
          · Pessimistic – full calendar range (cluster always on)
          · Central     – average of the two
      - Energy per model: proportional to compute weight = tokens × params_B
        (proxy for FLOPs: more parameters = more matrix multiplications per token)
      - CO2: energy_facility × CO2_FACTOR  (facility = IT energy × PUE)

    Limitations:
      - PDU measurement covers only 80 minutes (3 Dec 2025) – assumed representative
      - PUE = 1.7 is a standard estimate; real datacenter value unknown
      - Compute weight is a proxy, not a direct measurement
      - Models excluded due to missing parameter data are not estimated
    """
    # Cluster power from PDU readings
    power_per_gpu   = energy.groupby("GPU")["Input Active Power Total (W)"].mean()
    cluster_power_w = power_per_gpu.sum()

    # Uptime scenarios
    dates_with_data    = usage["Date"].drop_duplicates().sort_values()
    n_days_optimistic  = len(dates_with_data)
    n_days_pessimistic = (dates_with_data.max() - dates_with_data.min()).days + 1

    def kwh(days): return cluster_power_w * 24 * days / 1000

    energy_it = {
        "optimistic":  kwh(n_days_optimistic),
        "central":     kwh((n_days_optimistic + n_days_pessimistic) / 2),
        "pessimistic": kwh(n_days_pessimistic),
    }
    energy_fac = {k: v * PUE for k, v in energy_it.items()}

    # Aggregate usage by model
    agg = usage.groupby("Model").agg(
        total_requests=("Requests",     "sum"),
        total_tokens  =("Total Tokens", "sum"),
        total_spend   =("Spend ($)",    "sum"),
        active_days   =("Date",         "nunique"),
    ).reset_index()

    agg["params_B"]      = agg["Model"].map(params_map)
    agg["params_source"] = agg["params_B"].apply(
        lambda x: "Known" if pd.notna(x) else "MISSING"
    )

    # Compute weight and energy share (only for models with known params)
    known = agg["params_B"].notna()
    agg.loc[known, "weight"]  = agg.loc[known, "total_tokens"] * agg.loc[known, "params_B"]
    total_weight              = agg.loc[known, "weight"].sum()
    agg.loc[known, "share"]   = agg.loc[known, "weight"] / total_weight

    # Energy and CO2 for each scenario
    for scenario in ["optimistic", "central", "pessimistic"]:
        agg.loc[known, f"energy_fac_kWh_{scenario}"] = (
            agg.loc[known, "share"] * energy_fac[scenario]
        )
        agg.loc[known, f"co2_kg_{scenario}"] = (
            agg.loc[known, f"energy_fac_kWh_{scenario}"] * CO2_FACTOR
        )

    # Central scenario as default columns + efficiency metrics
    agg.loc[known, "energy_fac_kWh"] = agg.loc[known, "energy_fac_kWh_central"]
    agg.loc[known, "co2_kg"]         = agg.loc[known, "co2_kg_central"]
    agg.loc[known, "kWh_per_1M_tok"] = (
        agg.loc[known, "energy_fac_kWh"] / (agg.loc[known, "total_tokens"] / 1e6)
    )
    agg.loc[known, "Wh_per_req"]     = (
        agg.loc[known, "energy_fac_kWh"] * 1000 / agg.loc[known, "total_requests"]
    )
    agg.loc[known, "gCO2_per_req"]   = agg.loc[known, "Wh_per_req"] * CO2_FACTOR

    agg = agg.sort_values(
        "energy_fac_kWh", ascending=False, na_position="last"
    ).reset_index(drop=True)

    uptime = {
        "n_days_optimistic":   n_days_optimistic,
        "n_days_pessimistic":  n_days_pessimistic,
        **{f"energy_it_{k}":  v for k, v in energy_it.items()},
        **{f"energy_fac_{k}": v for k, v in energy_fac.items()},
    }

    return agg, power_per_gpu, cluster_power_w, uptime

